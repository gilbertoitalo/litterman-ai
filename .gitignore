# ── Ambiente local ────────────────────────────────────────────────────────────
.env
venv/
activate.ps1          # script local, não vai para o repo

# ── Base de dados local ───────────────────────────────────────────────────────
data/*.db             # SQLite gerado em runtime — não commitar
data/*.db-wal         # WAL files do SQLite
data/*.db-shm
!data/.gitkeep        # mas preserva a pasta vazia no repo

# ── Credenciais GCP ───────────────────────────────────────────────────────────
service_account.json
*-credentials.json

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ── VS Code ───────────────────────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

